# Salin ke .env lalu sesuaikan. Jangan pernah commit .env.
APP_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=populi
POSTGRES_PASSWORD=ganti_untuk_produksi
POSTGRES_DB=populi
# Port di HOST. Sengaja bukan 5432: di mesin pengembang sering sudah ada
# PostgreSQL native di 5432, dan psql ke localhost:5432 bisa mengenai
# database yang salah. Di dalam jaringan compose tetap 5432.
POSTGRES_PORT=5433
# Dipakai layanan api di dalam jaringan compose (host = nama layanan "db")
DATABASE_URL=postgresql+asyncpg://populi:ganti_untuk_produksi@db:5432/populi

# API
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Web
WEB_PORT=3000
# Dipanggil dari browser pengguna
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Dipanggil dari server Next.js di dalam jaringan compose
API_INTERNAL_BASE_URL=http://api:8000/api/v1
